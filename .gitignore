__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
coverage.json
.coverage
*.egg-info/
build/
dist/
dist-wheel/
.venv/
venv/

# Never commit experiment keys. See docs/adr/002-canary-wire-format.md.
*.key
*.pem
keys/
secrets/

# Evidence bundles are produced locally and reviewed before any publication.
evidence/
!probe/gpu_seal/evidence/
!probe/gpu_seal/evidence/*.py
out/
*.result.json

# Reviewed, committed real-hardware evidence. tests/unit/test_committed_evidence.py
# refuses anything in here that is simulated, unsigned, or unverifiable, and
# refuses stray files, so this exception does not let scratch output in.
!examples/evidence/
!examples/evidence/**/*.result.json

# Real provider identity — CHARTER.md §7.6. The public records in
# docs/provider-policy-review/*.json are pseudonymous by design; the actual
# names, source URLs, and contact addresses live only here, never in git.
docs/provider-policy-review/private/

# Local liveness scorecard history; each run is append-only provenance, not a
# reviewed source artifact.
.provenance/scorecard-history.jsonl
