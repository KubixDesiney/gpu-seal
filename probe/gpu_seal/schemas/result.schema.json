{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/KubixDesiney/gpu-seal/schemas/result.schema.json",
  "title": "GPU-SEAL signed result bundle",
  "description": "One signed measurement bundle. See CHARTER.md §10. The `safety` object is required and its assertions are structural: a bundle that cannot make them is not emitted.",
  "type": "object",
  "required": [
    "schema_version",
    "experiment_id",
    "run_id",
    "timestamp_utc",
    "provider_code",
    "tool",
    "probes",
    "safety",
    "integrity"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "gpu-seal-result-v1" },
    "experiment_id": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "timestamp_utc": { "type": "string", "format": "date-time" },

    "provider_code": {
      "type": "string",
      "description": "Pseudonymous provider code (provider-a, provider-b, ...). Real names are never written here during the pilot. CHARTER.md §7.6.",
      "minLength": 1
    },
    "region_claim": { "type": "string" },
    "product_claim": { "type": "string" },

    "tool": {
      "type": "object",
      "required": ["version", "commit"],
      "additionalProperties": false,
      "properties": {
        "version": { "type": "string" },
        "commit": { "type": "string" },
        "container_digest": { "type": ["string", "null"] },
        "kernel_bundle_hash": { "type": ["string", "null"] },
        "cuda_runtime_version": { "type": ["string", "null"] },
        "cuda_driver_version": { "type": ["string", "null"] }
      }
    },

    "environment": { "type": "object" },
    "allocation_model": { "type": "object" },

    "probes": {
      "type": "array",
      "description": "Safe aggregate statistics over memory GPU-SEAL did not write — §9.2, §9.3, §9.4, §9.12.",
      "items": {
        "oneOf": [
          { "$ref": "#/definitions/aggregateRecord" },
          { "$ref": "#/definitions/canaryOnlyRecord" },
          { "$ref": "#/definitions/redactedStopRecord" }
        ]
      }
    },

    "observations": {
      "type": "array",
      "description": "Findings from probes that never read unknown memory — §9.1, §9.6, §9.7, §9.8, §9.9, §9.10, §9.11. A separate list from `probes` because the disclosure hazard is different: these carry description of the rented environment, which is where CHARTER.md §10's never-published identifiers would otherwise leak. Added under schema_version v1 as an optional property, so bundles signed before it existed still validate.",
      "items": { "$ref": "#/definitions/observationRecord" }
    },

    "report_card": {
      "type": "object",
      "description": "CHARTER.md §13 grades. Independent categories, no composite score — a `score` or `total` property here would be a charter violation, not a feature."
    },

    "safety": {
      "type": "object",
      "required": [
        "raw_unknown_memory_retained",
        "unknown_memory_rendered",
        "canary_only_search",
        "sensitive_observation",
        "automatic_publication_allowed"
      ],
      "additionalProperties": false,
      "properties": {
        "raw_unknown_memory_retained": {
          "const": false,
          "description": "MUST be false. CHARTER.md §7.2 forbids storing raw unknown buffers; a true value indicates a bug in the probe, not a research finding."
        },
        "unknown_memory_rendered": {
          "const": false,
          "description": "MUST be false. CHARTER.md §7.2 forbids printing or decoding unknown bytes."
        },
        "canary_only_search": {
          "const": true,
          "description": "MUST be true. CHARTER.md §7.1: only operator-generated canaries are ever searched for."
        },
        "sensitive_observation": { "type": "boolean" },
        "automatic_publication_allowed": { "type": "boolean" }
      },
      "allOf": [
        {
          "description": "CHARTER.md §7.3 / §16 test 7 — a sensitive observation can never be auto-published.",
          "if": { "properties": { "sensitive_observation": { "const": true } } },
          "then": {
            "properties": { "automatic_publication_allowed": { "const": false } }
          }
        }
      ]
    },

    "integrity": {
      "type": "object",
      "required": ["payload_hash", "signature_algorithm", "signature"],
      "additionalProperties": false,
      "properties": {
        "payload_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "signature_algorithm": { "const": "ed25519" },
        "signature": { "type": "string", "pattern": "^[0-9a-f]{128}$" },
        "public_key": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "public_key_fingerprint": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    }
  },

  "definitions": {
    "observationRecord": {
      "type": "object",
      "description": "One interpreted, publishable observation about the environment. Every property appears in gpu_seal.safety.policy.SAFE_OBSERVATION_KEYS; additionalProperties is false so an un-reviewed field cannot ride along.",
      "required": [
        "probe_name",
        "probe_version",
        "subject",
        "category",
        "classification"
      ],
      "additionalProperties": false,
      "properties": {
        "probe_name": { "type": "string" },
        "probe_version": { "type": "string" },
        "subject": {
          "type": "string",
          "description": "Stable column key for the cross-provider dataset. Must not encode run-specific detail, and must not name a CHARTER.md §10 never-published identifier except in its `_hash` form."
        },
        "category": { "type": "string" },
        "classification": {
          "type": "string",
          "description": "Drawn from EXPOSURE_CLASSIFICATIONS, ALLOCATION_MODEL_CLASSES, or CONSISTENCY_BANDS depending on `category`."
        },
        "value": {},
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "evidence": { "type": "array", "items": { "type": "string" } },
        "limitations": { "type": "array", "items": { "type": "string" } },
        "not_testable_reason": { "type": ["string", "null"] },
        "error_code": { "type": ["string", "null"] },
        "timing_ns": { "type": ["integer", "null"], "minimum": 0 },
        "blocks_publication": {
          "type": "boolean",
          "description": "True when this observation alone must block automatic publication of the bundle (e.g. a positive self-canary recovery, or a reading from a modelled/non-evidence instrument). Mirrors aggregateRecord.sensitive_observation."
        }
      },
      "allOf": [
        {
          "description": "A `not_testable` classification with no reason is indistinguishable from a probe that failed silently.",
          "if": { "properties": { "classification": { "const": "not_testable" } } },
          "then": {
            "required": ["not_testable_reason"],
            "properties": {
              "not_testable_reason": { "type": "string", "minLength": 1 }
            }
          }
        }
      ]
    },

    "aggregateRecord": {
      "type": "object",
      "description": "Safe aggregate statistics over unknown memory. Every property here appears in gpu_seal.safety.policy.SAFE_AGGREGATE_KEYS. additionalProperties is false so an un-reviewed field cannot ride along.",
      "required": [
        "probe_name",
        "probe_version",
        "buffer_size_bytes",
        "measurement_hash",
        "zero_fraction",
        "entropy_estimate",
        "owned_canary_match",
        "canary_only_search"
      ],
      "additionalProperties": false,
      "properties": {
        "probe_name": { "type": "string" },
        "probe_version": { "type": "string" },
        "buffer_size_bytes": { "type": "integer", "minimum": 0 },
        "block_size_bytes": { "type": "integer", "minimum": 1 },
        "measurement_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },

        "zero_fraction": { "type": "number", "minimum": 0, "maximum": 1 },
        "fixed_pattern_fraction": { "type": "number", "minimum": 0, "maximum": 1 },
        "entropy_estimate": { "type": "number", "minimum": 0, "maximum": 1 },
        "repeated_block_count": { "type": "integer", "minimum": 0 },
        "distinct_block_count": { "type": "integer", "minimum": 0 },
        "byte_histogram": {
          "type": "array",
          "minItems": 256,
          "maxItems": 256,
          "items": { "type": "integer", "minimum": 0 }
        },

        "owned_canary_match": { "type": "boolean" },
        "owned_canary_exact_matches": { "type": "integer", "minimum": 0 },
        "owned_canary_longest_prefix": { "type": "integer", "minimum": 0 },

        "sensitive_observation": { "type": "boolean" },
        "unknown_raw_retained": { "const": false },
        "unknown_memory_rendered": { "const": false },
        "canary_only_search": { "const": true },

        "driver_metadata": { "type": ["object", "null"] },
        "error_code": { "type": ["string", "null"] },
        "timing_ns": { "type": ["integer", "null"], "minimum": 0 }
      },
      "allOf": [
        {
          "description": "Sensitive observations must use redactedStopRecord; reconstructive aggregate fields may not survive a stop.",
          "not": {
            "required": ["sensitive_observation"],
            "properties": { "sensitive_observation": { "const": true } }
          }
        }
      ]
    },

    "redactedStopRecord": {
      "type": "object",
      "description": "Redacted evidence that a safety stop occurred. It deliberately excludes all reconstructive measurements.",
      "required": [
        "probe_name",
        "probe_version",
        "reason_code",
        "size_bucket",
        "boundary",
        "operational_metadata",
        "sensitive_observation",
        "unknown_raw_retained",
        "unknown_memory_rendered",
        "canary_only_search"
      ],
      "additionalProperties": false,
      "properties": {
        "probe_name": { "type": "string", "minLength": 1 },
        "probe_version": { "type": "string", "minLength": 1 },
        "reason_code": {
          "enum": [
            "unexpected_content",
            "high_entropy_content",
            "measurement_below_minimum"
          ]
        },
        "size_bucket": {
          "enum": ["lt-256", "256-4095", "4k-lt-1m", "gte-1m"]
        },
        "boundary": {
          "enum": [
            "UNSPECIFIED",
            "SAME_KERNEL",
            "SEPARATE_LAUNCH",
            "SEPARATE_STREAM",
            "SEPARATE_CONTEXT",
            "SEPARATE_PROCESS",
            "SEPARATE_CONTAINER",
            "SEPARATE_VM",
            "SEQUENTIAL_ALLOCATION",
            "MIG_SAME_PROFILE",
            "MIG_DIFFERENT_PROFILE",
            "GPU_RESET",
            "DRIVER_RELOAD",
            "HOST_REBOOT"
          ]
        },
        "operational_metadata": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "backend": { "type": "string" },
            "backend_is_real": { "type": "string" },
            "measurement_path": { "type": "string" },
            "shared_infrastructure": { "type": "string" },
            "expect_zeroed": { "type": "string" },
            "mode": { "type": "string" }
          }
        },
        "sensitive_observation": { "const": true },
        "unknown_raw_retained": { "const": false },
        "unknown_memory_rendered": { "const": false },
        "canary_only_search": { "const": true }
      }
    },

    "canaryOnlyRecord": {
      "type": "object",
      "description": "MIG self-canary output containing only owned-marker metadata and no successor-memory statistics.",
      "required": [
        "probe_name",
        "probe_version",
        "boundary",
        "owned_canary_match",
        "owned_canary_exact_matches",
        "owned_canary_longest_prefix",
        "operational_metadata",
        "sensitive_observation",
        "unknown_raw_retained",
        "unknown_memory_rendered",
        "canary_only_search"
      ],
      "additionalProperties": false,
      "properties": {
        "probe_name": { "type": "string", "minLength": 1 },
        "probe_version": { "type": "string", "minLength": 1 },
        "boundary": {
          "enum": [
            "UNSPECIFIED",
            "SAME_KERNEL",
            "SEPARATE_LAUNCH",
            "SEPARATE_STREAM",
            "SEPARATE_CONTEXT",
            "SEPARATE_PROCESS",
            "SEPARATE_CONTAINER",
            "SEPARATE_VM",
            "SEQUENTIAL_ALLOCATION",
            "MIG_SAME_PROFILE",
            "MIG_DIFFERENT_PROFILE",
            "GPU_RESET",
            "DRIVER_RELOAD",
            "HOST_REBOOT"
          ]
        },
        "owned_canary_match": { "type": "boolean" },
        "owned_canary_exact_matches": { "type": "integer", "minimum": 0 },
        "owned_canary_longest_prefix": { "type": "integer", "minimum": 0 },
        "operational_metadata": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "backend": { "type": "string" },
            "backend_is_real": { "type": "string" },
            "measurement_path": { "type": "string" },
            "shared_infrastructure": { "type": "string" },
            "expect_zeroed": { "type": "string" },
            "mode": { "type": "string" }
          }
        },
        "sensitive_observation": { "const": false },
        "unknown_raw_retained": { "const": false },
        "unknown_memory_rendered": { "const": false },
        "canary_only_search": { "const": true }
      }
    }
  }
}
