{
  "name": "gpu-seal-dashboard",
  "version": "0.1.0-dev.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "vinext start",
    "test": "npm run build && node --test tests/rendered-html.test.mjs tests/production-smoke.test.mjs",
    "typecheck": "tsc --noEmit --incremental false",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "test:production": "node --test tests/production-smoke.test.mjs",
    "test:browser": "playwright test tests/browser.spec.ts"
  },
  "dependencies": {
    "lucide-react": "^1.28.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260901.1",
    "@playwright/test": "1.57.0",
    "@cloudflare/vite-plugin": "1.54.2",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "cross-env": "^10.1.0",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.8",
    "vite": "8.2.0",
    "wrangler": "4.127.1"
  },
  "overrides": {
    "esbuild": "0.28.1",
    "nanoid": "3.3.18",
    "postcss": "8.5.26",
    "sharp": "0.35.4"
  },
  "type": "module"
}
